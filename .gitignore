node_modules/
dist/
/data/
apps/server/data/
out/
.env
.DS_Store
apps/game/.godot/
*.import
.claude


# Godot import settings (compression, mipmaps, normal maps) must travel with the repo, and so must
# the resource UIDs they hold: a fresh clone that regenerates them gets new UIDs, and scenes that
# point at the old ones (the village road texture) warn and fall back to the file path.
!apps/game/**/*.import

# Transfer bundles and patches moved between machines by hand: never part of the game.
.xfer/
