{
  "name": "bebbikart",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev": "bun scripts/dev.js",
    "dev:server": "bun run --cwd apps/server dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:game": "godot --path apps/game",
    "kit:export": "bun packages/shared/scripts/export-godot.js",
    "test": "bun test packages apps/server",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0"
  }
}
