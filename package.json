{
  "name": "bebbikart",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "setup": "bun scripts/setup.js",
    "dev": "bun scripts/dev.js",
    "dev:server": "bun run --cwd apps/server dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:game": "bun run game:import && godot --path apps/game -- --server",
    "kit:export": "bun packages/shared/scripts/export-godot.js",
    "maps:export": "bun run game:import && godot --headless --path apps/game --script res://tools/export_track_maps.gd",
    "maps:check": "bun run game:import && godot --headless --path apps/game --script res://tools/export_track_maps.gd -- --check",
    "test": "bun test packages apps/server apps/web",
    "lint": "biome check .",
    "format": "biome check --write .",
    "game:mock": "bun run game:import && godot --path apps/game",
    "build:web": "bun run --cwd apps/web build",
    "start": "bun run build:web && bun run --cwd apps/server start",
    "play": "bun scripts/play.js",
    "game:export": "bun scripts/game-export.js",
    "game:import": "bun scripts/godot-import.js",
    "game:templates": "bun scripts/godot-templates.js",
    "audio:cues": "bun scripts/race-end-cues.js",
    "fake-game": "bun apps/server/scripts/fake-game.js",
    "sim-players": "bun apps/server/scripts/sim-players.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0"
  }
}
