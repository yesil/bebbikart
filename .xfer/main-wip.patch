+## Whether a half's camera shows its racer from the front: while it waits on the grid for its
+## lights, and while it cheers or slumps after its lap (a kit racer's leave()). Never while it
+## races: the kid steering needs to see the road ahead.
+func _shows_front(rid: String, v, r) -> bool:
+	var leaving_as = v.get("leaving")  # kit views only; "" while racing
+	if leaving_as != null and String(leaving_as) != "":
+		return true
+	return r != null and (sim.on_grid(rid) or r.state == "queued")
+
+
+## --kit mock race: render a sample racer's face for its plate (the server does this for real
+## players). One render at a time; the plate shows the face once it is done.
+func _queue_mock_avatar(pid: String, spec: Dictionary) -> void:
+	if _mock_avatars.has(pid):
+		return
+	_mock_avatars[pid] = null
+	if _avatar_renderer == null:
+		_avatar_renderer = AvatarRenderer.new()
+		add_child(_avatar_renderer)
+	if not _avatar_renderer.can_render():
+		return  # headless tools draw no plates
+	_avatar_jobs.append([pid, spec])
+	if _avatar_jobs.size() == 1:
+		_render_mock_avatars()
+
+
+func _render_mock_avatars() -> void:
+	while not _avatar_jobs.is_empty():
+		var job: Array = _avatar_jobs[0]
+		var paths: Dictionary = await _avatar_renderer.render_all(job[1], job[0])
+		var png := String(paths.get("avatar_happy", ""))
+		if png == "":
+			var err := "mock avatar for %s did not render (see the AvatarRenderer error above)" % nicks.get(job[0], "?")
+			push_error(err)
+			hud.problem(err)
+		else:
+			_mock_avatars[job[0]] = ImageTexture.create_from_image(Image.load_from_file(png))
+		_avatar_jobs.pop_front()
+
+
