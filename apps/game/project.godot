; Engine configuration file.

config_version=5

[application]

config/name="BebbiKart"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[editor_plugins]

enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg", "res://addons/road-generator/plugin.cfg", "res://addons/proton_scatter/plugin.cfg")

[shader_globals]

road_wetness={
"type": "float",
"value": 0.0
}
wind_strength={
"type": "float",
"value": 0.0
}
wind_dir={
"type": "vec2",
"value": Vector2(1, 0)
}
